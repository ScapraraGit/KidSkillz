# Capacitor — commit the native project sources (ios/, android/) but never their
# build outputs, dependency caches, or generated web bundle copies.

# Synced web assets (regenerated by `cap sync` from dist/)
ios/App/App/public/
android/app/src/main/assets/public/
capacitor.config.json

# iOS build artifacts / CocoaPods
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
ios/DerivedData/
*.xcuserstate

# Android build artifacts / Gradle
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
*.iml

# Signing material — never commit
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
