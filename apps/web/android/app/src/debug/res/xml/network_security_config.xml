<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY. Lives under src/debug so it is merged into debug builds only;
  release builds never see it and keep Android's cleartext-blocked default.
  Permits plaintext HTTP to the emulator's host-loopback alias (10.0.2.2) and
  localhost so a debug build can reach a local apps/api at http://10.0.2.2:4000.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
