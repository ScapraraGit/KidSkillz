<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY manifest overlay. The manifest merger applies this to debug builds
  only, attaching the cleartext network-security-config (see res/xml). Release
  builds inherit none of this and stay HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
