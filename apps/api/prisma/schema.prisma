generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  CAREGIVER
  CHILD
}

enum InvitationKind {
  CO_PARENT
  CAREGIVER
  CAREGIVER_PIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProofRequirement {
  NONE
  NOTES_OPTIONAL
  NOTES_REQUIRED
  PHOTO_OPTIONAL
  PHOTO_REQUIRED
  PHOTO_AND_NOTES
}

enum TaskKind {
  ONE_TIME
  RECURRING
}

enum AssignmentMode {
  ASSIGNED
  UP_FOR_GRABS
  TEAM
}

enum TeamSplit {
  EVEN
  FULL
}

enum MissedOpportunityMode {
  OFF
  GENTLE
  SAVAGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InitiativeKind {
  PLANNED
  WRITE_IN
}

enum RewardType {
  SCREEN_TIME
  GAME_TIME
  MOVIE_NIGHT
  MONEY
  TREAT
  ACTIVITY
  CUSTOM
}

enum LedgerKind {
  TASK
  INITIATIVE
  INITIATIVE_BONUS
  REDEMPTION
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  LEVEL_UP
  CHALLENGE_BONUS
  PENALTY
}

enum ChallengeKind {
  COMPLETE_N_TASKS
  EARN_N_CREDITS
  INITIATIVE_N_TIMES
  NO_MISSES
  EARLY_BIRD
}

enum ChallengeWindow {
  DAY
  WEEK
}

enum ChildViewMode {
  YOUNGER
  OLDER
}

enum NotificationKind {
  COMPLETION_APPROVED
  COMPLETION_REJECTED
  REDEMPTION_APPROVED
  REDEMPTION_REJECTED
  INITIATIVE_APPROVED
  INITIATIVE_REJECTED
  CHALLENGE_COMPLETED
  LEVEL_UP
  KUDOS
}

model Family {
  id        String   @id @default(uuid())
  name      String
  settings  Json
  // 6-char alphanumeric code parents share verbally for SHARED_DEVICE family lookup.
  // Unique across all families. Null only on legacy rows pending backfill.
  familyCode          String?  @unique
  // bcrypt hash of the shared-device password (distinct from any parent password).
  // Required when childAuthMode = SHARED_DEVICE. Null during migration window.
  devicePasswordHash  String?
  // Family-level beta-program flag. When true, /beta routes are accessible and
  // the dashboard beta banner shows for parents. Toggled by admins.
  isBeta              Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  childProfiles   ChildProfile[]
  tasks           Task[]
  rewards         Reward[]
  initiatives     InitiativeRequest[]
  ledger          LedgerEntry[]
  invitations     Invitation[]
  challenges      Challenge[]
  challengeProgress ChallengeProgress[]
  notifications   Notification[]
  taskCategories  TaskCategory[]
  taskJoins       TaskJoin[]
  missedOpportunities MissedOpportunity[]
  savingsGoals    ChildSavingsGoal[]
  legalAcceptances LegalAcceptance[] @relation("LegalAcceptanceFamily")
  auditEvents      AuditEvent[]
  enrolledDevices    EnrolledDevice[]
  deviceEnrollments  DeviceEnrollment[]
}

// Long-lived family-scoped credential held by a paired kid/caregiver device.
// The device token itself never identifies a user — it only allows the device
// to enumerate that family's kid profiles and submit PIN attempts scoped to
// that family. User identity still comes from PIN + the resulting JWT.
model EnrolledDevice {
  id              String    @id @default(uuid())
  familyId        String
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label           String
  // sha256(deviceToken). Raw token returned once at redeem time.
  deviceTokenHash String    @unique
  enrolledAt      DateTime?
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  revokedById     String?
  createdById     String
  createdAt       DateTime  @default(now())

  @@index([familyId])
}

// Short-lived single-use pairing artifact. The parent UI displays an 8-char
// pairingCode + a QR-encoded JWT (qrNonce); either can be redeemed to mint
// an EnrolledDevice + raw deviceToken.
model DeviceEnrollment {
  id               String    @id @default(uuid())
  familyId         String
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  codeHash         String    @unique
  nonceHash        String?   @unique
  label            String?
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedDeviceId String?
  createdById      String
  createdAt        DateTime  @default(now())

  @@index([familyId, expiresAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actorId    String?  // null = system-posted (cron, automation)
  kind       String   // e.g. "FAMILY_SETTINGS_UPDATED", "CHILD_CREATED", "TASK_DELETED"
  targetType String?  // e.g. "User", "Task", "Reward"
  targetId   String?
  payload    Json?    // small structured diff or context; redact secrets at call site
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([actorId])
}

model User {
  id           String   @id @default(uuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role         Role
  name         String
  email        String?  @unique
  passwordHash String?
  pin          String?  // 4-digit, child individual mode
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Monotonically incremented by "logout everywhere" — JWTs carry the value at
  // mint time, requireAuth rejects on mismatch so all outstanding access tokens
  // for the user die instantly.
  tokenVersion      Int       @default(0)
  avatarColor  String   @default("#6366f1")
  avatarConfig Json?
  isActive     Boolean  @default(true)
  onboardedAt  DateTime?
  householdAckAt DateTime?
  emailVerifiedAt        DateTime?
  isAdmin                Boolean   @default(false)
  acceptedTermsVersion   Int?
  acceptedTermsAt        DateTime?
  // CAREGIVER-only access window + permission scope. Null on PARENT/CHILD.
  validFrom    DateTime?
  validUntil   DateTime?
  scope        Json?
  invitedById  String?
  invitedBy    User?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees     User[]   @relation("InvitedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  childProfile        ChildProfile?
  assignedTasks       Task[]                @relation("AssignedTasks")
  taskCompletions     TaskCompletion[]      @relation("CompletionChild")
  reviewedCompletions TaskCompletion[]      @relation("CompletionReviewer")
  initiatives         InitiativeRequest[]   @relation("InitiativeChild")
  reviewedInitiatives InitiativeRequest[]   @relation("InitiativeReviewer")
  redemptions         Redemption[]          @relation("RedemptionChild")
  reviewedRedemptions Redemption[]          @relation("RedemptionReviewer")
  ledgerEntries       LedgerEntry[]         @relation("LedgerChild")
  createdLedger       LedgerEntry[]         @relation("LedgerCreator")
  createdInvitations  Invitation[]          @relation("InvitationCreator")
  acceptedInvitations Invitation[]          @relation("InvitationAcceptor")
  challengeProgress   ChallengeProgress[]   @relation("ChallengeProgressChild")
  notifications       Notification[]        @relation("NotificationUser")
  emailVerifications  EmailVerification[]   @relation("EmailVerificationUser")
  passwordResets      PasswordReset[]       @relation("PasswordResetUser")
  refreshTokens       RefreshToken[]        @relation("RefreshTokenUser")
  legalAcceptances    LegalAcceptance[]     @relation("LegalAcceptanceUser")

  @@index([familyId])
}

model Invitation {
  id           String           @id @default(uuid())
  familyId     String
  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  kind         InvitationKind
  status       InvitationStatus @default(PENDING)
  // Email for CO_PARENT/CAREGIVER. Null for CAREGIVER_PIN (in-person).
  email        String?
  inviteeName  String?
  // SHA-256 of token (CO_PARENT/CAREGIVER) or PIN (CAREGIVER_PIN). Never store raw.
  tokenHash    String           @unique
  expiresAt    DateTime
  // CAREGIVER-only fields, ignored for CO_PARENT.
  validFrom    DateTime?
  validUntil   DateTime?
  scope        Json?
  createdById  String
  createdBy    User             @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedById String?
  acceptedBy   User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
}

model ChildProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId                 String
  family                   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptionPaused         Boolean  @default(false)
  earningPaused            Boolean  @default(false)
  proofRequirementOverride ProofRequirement?
  soundEnabled             Boolean  @default(false)
  viewMode                 ChildViewMode @default(YOUNGER)
  savingsGoalRewardId      String?  // deprecated — superseded by ChildSavingsGoal join table
  streakGraceCount         Int      @default(0)
  penaltiesExempt          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  savingsGoals ChildSavingsGoal[]

  @@index([familyId])
}

model Task {
  id               String           @id @default(uuid())
  familyId         String
  family           Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  creditValue      Int
  category         String?
  kind             TaskKind         @default(ONE_TIME)
  recurrence       Json?            // { frequency, daysOfWeek, expiresAt }
  dueAt            DateTime?
  dueByTime        String?          // HH:MM in family TZ; only meaningful for RECURRING tasks
  // Number of times this RECURRING task must be done per day (1..10). ONE_TIME tasks
  // are always 1. Each completion of a multi-slot task is independent — brushing
  // teeth at slot 0 (morning) and slot 1 (bedtime) are two separate completions.
  timesPerDay      Int              @default(1)
  // Optional UI labels for each slot. Must be length 0 (use "#N" fallback) or equal
  // to timesPerDay. Example: ["Morning","Evening"].
  slotLabels       String[]         @default([])
  defaultDurationMinutes Int?       // optional kid-focus timer default; 1..240
  proofRequirement ProofRequirement @default(NOTES_OPTIONAL)
  isActive         Boolean          @default(true)
  assignmentMode   AssignmentMode   @default(ASSIGNED)
  teamSplit        TeamSplit        @default(EVEN)
  missedPenalty    Int              @default(0)
  categoryId       String?
  taskCategory     TaskCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?            @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  completions TaskCompletion[]
  taskJoins   TaskJoin[]
  missedOpportunities MissedOpportunity[]

  @@index([familyId])
  @@index([assignedToId])
  @@index([categoryId])
}

model TaskCategory {
  id        String   @id @default(uuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  icon      String   // emoji string
  color     String?  // optional tailwind color token
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tasks Task[]

  @@unique([familyId, name])
  @@index([familyId])
}

model TaskJoin {
  id             String   @id @default(uuid())
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  childId        String
  occurrenceDate String?  // YYYY-MM-DD for RECURRING; null for ONE_TIME
  // 0-based slot within the occurrence day for multi-per-day RECURRING tasks. 0 for ONE_TIME.
  slotIndex      Int      @default(0)
  createdAt      DateTime @default(now())

  // Uniqueness on (taskId, childId, occurrenceDate, slotIndex) is enforced via
  // two partial indexes (see 20260515200000_task_multi_slot migration): one WHERE
  // occurrenceDate IS NOT NULL and one WHERE occurrenceDate IS NULL. NULLs are
  // distinct under a normal UNIQUE, so partial indexes give per-(slot) coverage.
  @@index([familyId])
  @@index([taskId, occurrenceDate])
}

model MissedOpportunity {
  id               String   @id @default(uuid())
  familyId         String
  family           Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate   String?  // YYYY-MM-DD for RECURRING; null for ONE_TIME
  // 0-based slot within the occurrence day. 0 for ONE_TIME / single-slot RECURRING.
  slotIndex        Int      @default(0)
  claimedByUserId  String   // parent or caregiver who self-claimed
  createdAt        DateTime @default(now())

  @@unique([taskId, occurrenceDate, slotIndex])
  @@index([familyId, createdAt])
}

model ChildSavingsGoal {
  id        String   @id @default(uuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     ChildProfile @relation(fields: [childId], references: [userId], onDelete: Cascade)
  rewardId  String
  position  Int      // 1..3
  createdAt DateTime @default(now())

  @@unique([childId, position])
  @@unique([childId, rewardId])
  @@index([familyId])
}

model TaskCompletion {
  id              String         @id @default(uuid())
  taskId          String
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  childId         String
  child           User           @relation("CompletionChild", fields: [childId], references: [id], onDelete: Cascade)
  status          ApprovalStatus @default(PENDING)
  notes           String?
  photoKey        String?
  occurrenceDate  String?        // YYYY-MM-DD for RECURRING; null for ONE_TIME
  // 0-based slot for multi-per-day RECURRING tasks. 0 for ONE_TIME / single-slot.
  slotIndex       Int            @default(0)
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewer        User?          @relation("CompletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  creditAwarded   Int?
  parentNote      String?        // optional kudos message from parent on approve

  @@unique([taskId, childId, occurrenceDate, slotIndex])
  @@index([childId])
  @@index([status])
}

model InitiativeRequest {
  id               String         @id @default(uuid())
  familyId         String
  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId          String
  child            User           @relation("InitiativeChild", fields: [childId], references: [id], onDelete: Cascade)
  kind             InitiativeKind
  title            String
  description      String?
  suggestedCredits Int
  status           ApprovalStatus @default(PENDING)
  notes            String?
  photoKey         String?
  submittedAt      DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewer         User?          @relation("InitiativeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  creditAwarded    Int?
  bonusApplied     Int?

  @@index([familyId])
  @@index([childId])
  @@index([status])
}

model Reward {
  id               String     @id @default(uuid())
  familyId         String
  family           Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  creditCost       Int
  type             RewardType
  requiresApproval Boolean    @default(true)
  isActive         Boolean    @default(true)
  weeklyLimit      Int?
  dailyLimit       Int?
  metadata         Json       @default("{}")
  eligibleChildIds String[]   @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions Redemption[]

  @@index([familyId])
}

model Redemption {
  id            String         @id @default(uuid())
  rewardId      String
  reward        Reward         @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  childId       String
  child         User           @relation("RedemptionChild", fields: [childId], references: [id], onDelete: Cascade)
  status        ApprovalStatus @default(PENDING)
  creditCost    Int
  quantity      Int            @default(1)
  notes         String?
  requestedAt   DateTime       @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewer      User?          @relation("RedemptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([childId])
  @@index([rewardId])
  @@index([status])
}

model LedgerEntry {
  id           String      @id @default(uuid())
  familyId     String
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId      String
  child        User        @relation("LedgerChild", fields: [childId], references: [id], onDelete: Cascade)
  amount       Int
  kind         LedgerKind
  reason       String
  sourceType   String?
  sourceId     String?
  createdById  String?
  createdBy    User?       @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([familyId])
  @@index([childId])
  @@index([createdAt])
}

model Challenge {
  id            String          @id @default(uuid())
  familyId      String
  family        Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  kind          ChallengeKind
  title         String
  target        Int
  window        ChallengeWindow
  rewardCredits Int
  isActive      Boolean         @default(true)
  startsAt      DateTime        @default(now())
  endsAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  progress ChallengeProgress[]

  @@index([familyId])
  @@index([isActive])
}

model ChallengeProgress {
  id           String    @id @default(uuid())
  familyId     String
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  childId      String
  child        User      @relation("ChallengeProgressChild", fields: [childId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD for DAY window, YYYY-Www for WEEK window. Scopes progress per period.
  periodKey    String
  value        Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([challengeId, childId, periodKey])
  @@index([familyId])
  @@index([childId])
}

model Notification {
  id        String           @id @default(uuid())
  familyId  String
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([familyId])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("EmailVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  email      String    // email at time of issuance — if user changes email, old tokens invalid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum LegalAcceptanceKind {
  TERMS
  PRIVACY
  CHILD_PROFILE_CONSENT
  UPLOAD_ACK
  HOUSEHOLD_TOOL_ACK
  NO_CASH_VALUE_ACK
}

// Long-lived refresh token issued at login. Rotated on every use: consuming a
// refresh token marks it revoked and links `replacedById` to the freshly minted
// successor, so a stolen-and-replayed token after rotation hits a tripwire.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   // id of the rotation successor, when revoked due to use
  userAgent    String?
  ip           String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Replay-protection cache for ledger-affecting mutations. Clients send
// `Idempotency-Key: <uuid>` on approve/redeem/adjust; the middleware caches the
// first response and serves it on subsequent hits with the same key for 24h.
model IdempotencyKey {
  id            String   @id @default(uuid())
  familyId      String
  key           String
  route         String
  statusCode    Int
  responseJson  Json
  createdAt     DateTime @default(now())

  @@unique([familyId, key])
  @@index([createdAt])
}

// Beta tester feedback submission. Single-row design — all ratings + free-text
// answers stored as JSONB in `payload` so the survey can evolve without a
// migration each time. Tagged via `tags` (string[]) for lightweight triage
// (bug | praise | feature_request | confusion). One row per submission; users
// may submit multiple times (e.g. revisits after fixes).
model BetaFeedback {
  id            String   @id @default(uuid())
  familyId      String
  userId        String
  // Coarse rating used for triage views; mirrors payload.ratings.overall (1..5).
  // Stored as a column so admin lists can ORDER BY without parsing JSON.
  overallRating Int?
  // Yes / No / Maybe — column-projected for the same reason as overallRating.
  recommend     String?
  tags          String[] @default([])
  payload       Json
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([userId])
}

// Per-user checklist completion tracker. Lets the Checklist page persist
// progress across reloads and gives us a funnel signal — who started the beta
// vs who finished and submitted feedback. One row per user; `completed` is the
// set of checklist item keys ticked.
model BetaChecklistProgress {
  id          String   @id @default(uuid())
  familyId    String
  userId      String   @unique
  completed   String[] @default([])
  submittedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([familyId])
}

// Append-only audit log of every legal/consent acceptance event.
// Records: who accepted, what kind, which version, when, from where (IP + UA).
// Optional subjectChildId for CHILD_PROFILE_CONSENT events.
model LegalAcceptance {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation("LegalAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)
  familyId       String
  family         Family              @relation("LegalAcceptanceFamily", fields: [familyId], references: [id], onDelete: Cascade)
  kind           LegalAcceptanceKind
  version        Int
  subjectChildId String?
  ipAddress      String?
  userAgent      String?
  context        String?
  createdAt      DateTime            @default(now())

  @@index([userId, kind])
  @@index([familyId])
  @@index([createdAt])
}
