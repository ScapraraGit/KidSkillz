{
  "name": "@chorechampz/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm build && cap sync android && cap open android",
    "cap:ios": "pnpm build && cap sync ios && cap open ios",
    "cap:dev:android": "cross-env CAP_ENV=dev vite build --mode mobile && cross-env CAP_ENV=dev cap sync android && cap open android",
    "cap:dev:ios": "cross-env CAP_ENV=dev vite build --mode mobile && cross-env CAP_ENV=dev cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.1",
    "@chorechampz/shared": "workspace:*",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "5.59.16",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "zustand": "5.0.1",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "^2.1.5"
  }
}
