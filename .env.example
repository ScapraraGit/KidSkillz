# =============================================================================
# ChoreChampz — example environment file
# Copy to `.env` and adjust per environment. Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared (docker-compose + tooling)
# -----------------------------------------------------------------------------
NODE_ENV=development

# Postgres container (used by docker-compose; ignored when pointing at Neon).
POSTGRES_USER=chorechampz
POSTGRES_PASSWORD=chorechampz
POSTGRES_DB=chorechampz
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API — apps/api
# Read in apps/api/src/env.ts.
# -----------------------------------------------------------------------------

# HTTP port the Express server listens on.
PORT=4000
API_PORT=4000

# Postgres connection string. For local docker-compose use the value below; for
# Neon/managed Postgres use the pooled connection URL.
DATABASE_URL=postgresql://chorechampz:chorechampz@db:5432/chorechampz?schema=public

# JWT signing secret. REQUIRED — no fallback. In production the API throws at
# startup if this is unset or shorter than 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-prod-please-use-32-plus-random-chars
# Legacy access-token lifetime knob. Kept for backwards-compat; superseded by
# JWT_ACCESS_TTL which is the value actually read in code.
JWT_TTL=7d
# Short-lived access token. 15 minutes is the default; refresh tokens carry the
# long horizon. Set in zeit/ms format (15m, 1h, 7d).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days. Shortened from 30 → 7 to reduce the stolen-
# token window while refresh tokens live in localStorage (XSS-exposed).
# Revisit once tokens migrate to httpOnly cookies.
REFRESH_TOKEN_TTL_DAYS=7

# Run the idempotent DB seed at container startup. Default `false` — flip to
# `true` only for first-deploy or local-dev so a buggy seed cannot crash a
# production deploy loop.
SEED_ON_STARTUP=false

# Upload storage (LocalStorage provider). Path inside the API container/process.
UPLOAD_DIR=/data/uploads
# Max upload size in bytes (5 MiB default).
UPLOAD_MAX_BYTES=5242880

# Allowed browser origin(s) for CORS. Accepts a single origin or a
# comma-separated list — useful in prod to allow apex + www + a Railway
# preview URL against the same API deploy. Exact-match only (no wildcards).
# Example prod value:
#   CORS_ORIGIN=https://www.chorechampz.com,https://chorechampz.com,https://chorechampsweb-production.up.railway.app
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app — used to build email links (verify, reset, invite).
APP_URL=http://localhost:5173

# Sentry server-side DSN. Leave empty in dev; SDK is a no-op when unset.
SENTRY_DSN=

# Resend transactional email. Get the API key at https://resend.com/api-keys.
# Keep `EMAIL_ENABLED=false` until the sending domain is fully verified
# (SPF + DKIM + DMARC all green in the Resend dashboard). When false the API
# falls back to a ConsoleProvider that logs sends instead of hitting Resend —
# safe default for dev/local. EMAIL_FROM must be on the verified domain.
RESEND_API_KEY=
EMAIL_FROM="ChoreChampz <no-reply@chorechampz.com>"
EMAIL_REPLY_TO=admin@chorechampz.com
EMAIL_ENABLED=false

# Photo proof feature gate. Stays `false` until S3 storage + retention sweeps
# are live. When `false`: PHOTO_* proof options are hidden in the UI, rejected
# at the API, and /uploads returns 503.
PHOTO_PROOF_ENABLED=false

# Cloudflare Turnstile secret for siteverify on unauth endpoints
# (parent/register, forgot-password, families/lookup). Leave empty in dev —
# middleware fails open when unset. Pair with VITE_TURNSTILE_SITEKEY below.
TURNSTILE_SECRET=

# Device pairing feature gate. When `true`: parents can issue pairing codes;
# kid/caregiver devices can redeem them for a long-lived device token. This is
# the supported kid/caregiver login path. Leave `false` only when intentionally
# running the legacy familyCode + shared-device-password flow.
DEVICE_PAIRING_ENABLED=true

# Org/school guardian-consent gate. When `false` (default for personal family
# use), the Add Kid modal hides the guardian-consent block and the API skips
# the CHILD_PROFILE_CONSENT LegalAcceptance write. When `true` (school/org
# deployments where staff create profiles on behalf of guardians), the consent
# checkbox is shown, required, and recorded per child.
ORG_CONSENT_REQUIRED=false

# Stripe billing — apps/api.
# BILLING_ENABLED is the server-side master kill-switch:
#   false (default) → /billing/* routes 404, paid-entitlement middleware
#   short-circuits to allow. Flip true once Stripe keys + prices configured.
BILLING_ENABLED=false
# Free trial length in days for new families. Read at family-create time.
BILLING_TRIAL_DAYS=10
# Stripe secret API key. Test mode "sk_test_..." for dev.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard webhook config. Without it,
# /billing/webhook rejects all deliveries.
STRIPE_WEBHOOK_SECRET=
# Stripe price ids for the two recurring plans. Both must be set when
# BILLING_ENABLED=true; checkout otherwise returns 503.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=

# Social login (Google). SOCIAL_LOGIN_ENABLED is the server-side master kill-
# switch. When `false` (default) the /auth/oauth/* routes 404 and the provider
# factory returns a disabled stub — safe in dev/local without a Google client.
# Flip `true` only once GOOGLE_OAUTH_CLIENT_ID/SECRET and REDIRECT_URI are
# configured and the redirect URI is whitelisted in the Google Cloud console.
# Pair with VITE_SOCIAL_LOGIN_ENABLED + VITE_GOOGLE_OAUTH_CLIENT_ID below.
SOCIAL_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI whitelisted in the Google Cloud console.
# Example prod: https://app.chorechampz.com/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

# Push notifications (mobile). PUSH_ENABLED is the server-side kill-switch. When
# `false` (default) push-provider.ts returns a ConsoleProvider that logs sends
# instead of calling FCM — safe for dev/local/CI with no credentials. Flip
# `true` only once a Firebase project + APNs key are configured.
# When PUSH_ENABLED=true, supply ONE of:
#   FCM_SERVICE_ACCOUNT_JSON — the entire Firebase service-account key file as a
#     single-line JSON string (the prod path).
#   FCM_PROJECT_ID — Application Default Credentials fallback for local dev when
#     org policy blocks service-account key creation. Run
#     `gcloud auth application-default login`, set this to your Firebase project
#     id, and firebase-admin uses your user's OAuth refresh token. LOCAL DEV ONLY —
#     ADC creds are tied to your machine and cannot ship to prod.
# Service-account JSON wins if both are set.
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# In-app purchase plan mapping. Comma-separated store product ids that grant the
# PREMIUM plan (e.g. com.chorechampz.premium.monthly). Any IAP product not listed
# resolves to BASIC. Empty (default) = treat all IAP products as BASIC. Mirrors
# the CORS comma-list convention; read in getEntitlement.
IAP_PREMIUM_PRODUCT_IDS=

# -----------------------------------------------------------------------------
# Web — apps/web
# Read in apps/web/src (via `import.meta.env.VITE_*`).
# Only VITE_-prefixed vars are exposed to the browser bundle.
# -----------------------------------------------------------------------------

# Dev server port.
WEB_PORT=5173

# Base URL the SPA points its fetch wrapper at. Must match the API's externally
# reachable URL (not the docker-internal hostname).
VITE_API_URL=http://localhost:4000

# Sentry browser DSN. Leave empty in dev; production builds wire a real value.
VITE_SENTRY_DSN=

# Cloudflare Turnstile public sitekey. Empty = widget hidden, CAPTCHA disabled.
# Must be set together with TURNSTILE_SECRET on the API side.
VITE_TURNSTILE_SITEKEY=

# UI kill-switch for the billing surface (TrialBanner, /parent/billing nav link,
# UpgradePrompt). Independent of server BILLING_ENABLED so the UI can be hidden
# while the backend still tracks state. Both must be true for billing UI to show.
VITE_BILLING_ENABLED=false

# Social login UI kill-switch. Independent of server SOCIAL_LOGIN_ENABLED so the
# UI can be hidden while the backend still tracks linked identities. Both must
# be true for the "Sign in with Google" button to show. VITE_GOOGLE_OAUTH_CLIENT_ID
# is the same client id as the API's GOOGLE_OAUTH_CLIENT_ID — needed in the
# browser bundle for any client-rendered branded button.
VITE_SOCIAL_LOGIN_ENABLED=false
VITE_GOOGLE_OAUTH_CLIENT_ID=
