# =============================================================================
# ChoreChampz — example environment file
# Copy to `.env` and adjust per environment. Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared (docker-compose + tooling)
# -----------------------------------------------------------------------------
NODE_ENV=development

# Postgres container (used by docker-compose; ignored when pointing at Neon).
POSTGRES_USER=chorechampz
POSTGRES_PASSWORD=chorechampz
POSTGRES_DB=chorechampz
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API — apps/api
# Read in apps/api/src/env.ts.
# -----------------------------------------------------------------------------

# HTTP port the Express server listens on.
PORT=4000
API_PORT=4000

# Postgres connection string. For local docker-compose use the value below; for
# Neon/managed Postgres use the pooled connection URL.
DATABASE_URL=postgresql://chorechampz:chorechampz@db:5432/chorechampz?schema=public

# JWT signing secret. MUST be replaced in production (use 32+ random bytes).
JWT_SECRET=change-me-in-prod-please
# Legacy access-token lifetime knob. Kept for backwards-compat; superseded by
# JWT_ACCESS_TTL which is the value actually read in code.
JWT_TTL=7d
# Short-lived access token. 15 minutes is the default; refresh tokens carry the
# long horizon. Set in zeit/ms format (15m, 1h, 7d).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days. Each use rotates and resets the clock client-side.
REFRESH_TOKEN_TTL_DAYS=30

# Upload storage (LocalStorage provider). Path inside the API container/process.
UPLOAD_DIR=/data/uploads
# Max upload size in bytes (5 MiB default).
UPLOAD_MAX_BYTES=5242880

# Allowed browser origin for CORS. Set to the deployed web URL in prod.
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app — used to build email links (verify, reset, invite).
APP_URL=http://localhost:5173

# Sentry server-side DSN. Leave empty in dev; SDK is a no-op when unset.
SENTRY_DSN=

# Photo proof feature gate. Stays `false` until S3 storage + retention sweeps
# are live. When `false`: PHOTO_* proof options are hidden in the UI, rejected
# at the API, and /uploads returns 503.
PHOTO_PROOF_ENABLED=false

# Cloudflare Turnstile secret for siteverify on unauth endpoints
# (parent/register, forgot-password, families/lookup). Leave empty in dev —
# middleware fails open when unset. Pair with VITE_TURNSTILE_SITEKEY below.
TURNSTILE_SECRET=

# Device pairing feature gate. When `true`: parents can issue pairing codes;
# kid/caregiver devices can redeem them for a long-lived device token. This is
# the supported kid/caregiver login path. Leave `false` only when intentionally
# running the legacy familyCode + shared-device-password flow.
DEVICE_PAIRING_ENABLED=true

# Org/school guardian-consent gate. When `false` (default for personal family
# use), the Add Kid modal hides the guardian-consent block and the API skips
# the CHILD_PROFILE_CONSENT LegalAcceptance write. When `true` (school/org
# deployments where staff create profiles on behalf of guardians), the consent
# checkbox is shown, required, and recorded per child.
ORG_CONSENT_REQUIRED=false

# -----------------------------------------------------------------------------
# Web — apps/web
# Read in apps/web/src (via `import.meta.env.VITE_*`).
# Only VITE_-prefixed vars are exposed to the browser bundle.
# -----------------------------------------------------------------------------

# Dev server port.
WEB_PORT=5173

# Base URL the SPA points its fetch wrapper at. Must match the API's externally
# reachable URL (not the docker-internal hostname).
VITE_API_URL=http://localhost:4000

# Sentry browser DSN. Leave empty in dev; production builds wire a real value.
VITE_SENTRY_DSN=

# Cloudflare Turnstile public sitekey. Empty = widget hidden, CAPTCHA disabled.
# Must be set together with TURNSTILE_SECRET on the API side.
VITE_TURNSTILE_SITEKEY=
