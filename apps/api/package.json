{
  "name": "@chorechampz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "prisma": "dotenv -e ../../.env -- prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "backfill:challenges": "dotenv -e ../../.env -- tsx prisma/backfill-challenges.ts",
    "jobs:no-misses": "dotenv -e ../../.env -- tsx prisma/run-no-misses.ts",
    "jobs:photo-purge": "dotenv -e ../../.env -- tsx prisma/run-photo-purge.ts",
    "jobs:photo-purge:ci": "tsx prisma/run-photo-purge.ts",
    "jobs:penalty-sweep": "dotenv -e ../../.env -- tsx prisma/run-penalty-sweep.ts",
    "jobs:penalty-sweep:ci": "tsx prisma/run-penalty-sweep.ts",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chorechampz/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.12.3",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "20.16.10",
    "@types/pino-http": "^6.1.0",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "^2.1.5",
    "dotenv-cli": "7.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.5"
  }
}
